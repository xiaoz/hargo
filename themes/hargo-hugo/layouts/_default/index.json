{{- $.Scratch.Add "index" slice -}}
{{- range where .Site.RegularPages "Section" "products" -}}
{{- $.Scratch.Add "index" (dict
  "title" .Title
  "url" .Permalink
  "product_id" .Params.product_id
  "price" .Params.price
  "categories" .Params.categories
  "tags" .Params.tags
  "description" (.Params.description | markdownify | plainify)
  "content" (.Content | markdownify | plainify)
  "variants" (.Params.variants | default slice)
) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}